NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI provider credentials stay server-side and are never exposed to Vite.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Optional existing RAG/vision backend. Keep this URL server-side.
LLM_SERVICE_URL=https://your-llm-service.example.com

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nestiadev

# Redis Cloud
# Use the Redis Cloud connection string, normally rediss:// for TLS.
REDIS_URL=rediss://default:password@<your-redis-cloud-host>:<port>
REDIS_MAX_HISTORY=100
# Inactivity TTL for active chat context. Allowed range: 30-360 minutes.
REDIS_SESSION_TTL_MINUTES=45

# Redis Cloud sliding-window rate limits
RATE_LIMIT_GENERAL_MAX=60
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
