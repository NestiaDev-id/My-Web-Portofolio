NODE_ENV=development
ALLOWED_ORIGINS=https://nestia.my.id,https://www.nestia.my.id
FRONTEND_URL=http://localhost:5173

# AI provider credentials stay server-side and are never exposed to Vite.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Optional existing RAG/vision backend. Keep this URL server-side.
LLM_SERVICE_URL=https://your-llm-service.example.com
# Must match INTERNAL_API_SECRET on the Hugging Face Space
LLM_SERVICE_SECRET=your_super_secret_internal_token_here

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nestiadev

# Redis Cloud
# Use the Redis Cloud connection string, normally rediss:// for TLS.
REDIS_URL=rediss://default:password@<your-redis-cloud-host>:<port>
REDIS_MAX_HISTORY=100
# Inactivity TTL for active chat context. Allowed range: 30-360 minutes.
REDIS_SESSION_TTL_MINUTES=45

# Redis Cloud sliding-window rate limits
RATE_LIMIT_GENERAL_MAX=60
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_PRESENCE_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# Realtime active presence in ChatMe (TTL in seconds: 20-120)
PRESENCE_TTL_SECONDS=35

# HuggingFace concurrency limiter & queue
HF_MAX_CONCURRENCY=2
HF_QUEUE_TIMEOUT_SECONDS=30

# Resend Outbound Email Service
RESEND_API_KEY=re_your_api_key_here
CONTACT_FROM_EMAIL=NestiaDev <noreply@nestia.my.id>
CONTACT_TO_EMAIL=support@nestia.my.id

# Cloudflare Turnstile (Anti-Bot Server Verification)
# Kosongkan pada mode development untuk bypass verifikasi otomatis
TURNSTILE_SECRET_KEY=

# Contact Form Sliding-Window Rate Limiting (Anti-Flooding)
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
