# ══════════════════════════════════════════════════════════
# LLM RAG Service — Environment Variables
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your secrets.

# ── Hugging Face ─────────────────────────────────────────
# API token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# LLM model to use via HF Inference API
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ── Upstash Redis (short-term chat memory) ───────────────
# Get your URL from https://console.upstash.com
REDIS_URL=rediss://default:xxxxxx@xxx.upstash.io:6379

# Max messages kept per session in Redis (rolling window)
REDIS_MAX_HISTORY=100

# ── MongoDB Atlas (permanent chat archive) ───────────────
# Get your URI from https://cloud.mongodb.com → Connect
MONGO_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=llm_chat_history

# ── ChromaDB (ephemeral vector store) ────────────────────
CHROMA_PATH=./chroma_db

# ── Embedding model ──────────────────────────────────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Text chunking ────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3
